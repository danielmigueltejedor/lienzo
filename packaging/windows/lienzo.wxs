<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <?ifndef HasCraftFontLicences ?>
  <?define HasCraftFontLicences=0 ?>
  <?endif?>
  <Package Name="Lienzo" Manufacturer="Nodalia" Version="$(var.Version)" UpgradeCode="9FCCBAB3-88D1-42AD-936C-04ABB215AE82" Scope="perUserOrMachine" Compressed="yes" Language="1033">
    <SummaryInformation Description="Lienzo image editor" Manufacturer="Nodalia" />
    <?include $(sys.SOURCEFILEDIR)install-policy.wxi?>
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of Lienzo is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- MSI caches this icon using its Id as the filename. Advertised shortcuts to an
         .exe need an .exe icon identifier (ICE50), even when the source is an ICO. -->
    <Icon Id="LienzoIcon.exe" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="LienzoIcon.exe" />
    <Property Id="ARPURLINFOABOUT" Value="https://getartcraft.com/apps/photocraft" />
    <Property Id="ARPURLUPDATEINFO" Value="https://getartcraft.com/apps/photocraft" />
    <Property Id="ARPHELPLINK" Value="https://discord.gg/artcraft" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="CraftSuiteFolder" Name="ArtCraft">
        <Directory Id="INSTALLFOLDER" Name="Lienzo" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <!-- An upgrade installs where the user put the previous version (written by LienzoApp). -->

    <Feature Id="Main" Title="Lienzo" Level="1">
      <?if $(var.HasCraftFontLicences) = 1 ?>
      <ComponentGroupRef Id="CraftFontLicences" />
      <?endif?>
      <ComponentGroupRef Id="LienzoFiles" />
    </Feature>

    <!-- The setup wizard: WixUI_InstallDir without its licence page (the code is MIT OR
         Apache-2.0; there is nothing to accept). A later NewDialog on the same button wins. -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UI>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="2" Condition="NOT Installed" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchLienzo" Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>
    <!-- Our own art, generated by package.ps1 from the app icon (not WiX's stock bitmaps). -->
    <WixVariable Id="WixUIBannerBmp" Value="$(var.BannerBmp)" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.DialogBmp)" />

    <!-- The full version (Version is numeric, so it drops a pre-release tag), shown on the wizard's
         pages through lienzo.en-us.wxl. -->
    <Property Id="LienzoVersion" Value="$(var.DisplayVersion)" />

    <!-- Finish page: say where to find the app, and offer to start it (ticked by default). -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT" Value="Lienzo $(var.DisplayVersion) is installed. You can start it any time from the Start menu." />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch Lienzo" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#LienzoExe]" />
    <!-- Runs in the wizard's own (unelevated) process, so the app starts as the user, not as admin. -->
    <CustomAction Id="LaunchLienzo" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec" Impersonate="yes" Return="ignore" />
  </Package>

  <Fragment>
    <?if $(var.HasCraftFontLicences) = 1 ?>
    <ComponentGroup Id="CraftFontLicences" Directory="INSTALLFOLDER">
      <Files Include="$(var.DocsDir)\**" />
    </ComponentGroup>
    <?endif?>
    <ComponentGroup Id="LienzoFiles" Directory="INSTALLFOLDER">
      <Component Id="LienzoApp" Guid="A6DE41B7-A80F-4C59-A17E-BB68065BF67E">
        <File Id="LienzoExe" Source="$(var.BinDir)\lienzo.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Lienzo" Description="Lienzo image editor" WorkingDirectory="INSTALLFOLDER" Advertise="yes" Icon="LienzoIcon.exe" IconIndex="0" />
        </File>

        <!-- .lienzo: Lienzo's own format; Lienzo is its default app. .pcraft is what documents were
             saved as before Lienzo had an extension of its own, so it still opens here. -->
        <ProgId Id="Lienzo.Document" Description="Lienzo Document" Icon="LienzoExe" IconIndex="0">
          <Extension Id="lienzo" ContentType="application/x-lienzo">
            <Verb Id="open" Command="Open" TargetFile="LienzoExe" Argument="&quot;%1&quot;" />
          </Extension>
          <Extension Id="pcraft" ContentType="application/x-lienzo">
            <Verb Id="open" Command="Open" TargetFile="LienzoExe" Argument="&quot;%1&quot;" />
          </Extension>
        </ProgId>
        <!-- PSD/PSB and images: offered under "Open with", never forced as the default. -->
        <ProgId Id="Lienzo.PhotoshopDocument" Description="PSD Document" Icon="LienzoExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Lienzo.PhotoshopDocument\shell\open\command" Value="&quot;[#LienzoExe]&quot; &quot;%1&quot;" Type="string" />
        <ProgId Id="Lienzo.Image" Description="Image" Icon="LienzoExe" IconIndex="0" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Lienzo.Image\shell\open\command" Value="&quot;[#LienzoExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.psd\OpenWithProgids" Name="Lienzo.PhotoshopDocument" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.psb\OpenWithProgids" Name="Lienzo.PhotoshopDocument" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.pdn\OpenWithProgids" Name="Lienzo.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.ora\OpenWithProgids" Name="Lienzo.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.kra\OpenWithProgids" Name="Lienzo.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.krz\OpenWithProgids" Name="Lienzo.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.png\OpenWithProgids" Name="Lienzo.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.jpg\OpenWithProgids" Name="Lienzo.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.jpeg\OpenWithProgids" Name="Lienzo.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.tif\OpenWithProgids" Name="Lienzo.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.tiff\OpenWithProgids" Name="Lienzo.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.webp\OpenWithProgids" Name="Lienzo.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.gif\OpenWithProgids" Name="Lienzo.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.bmp\OpenWithProgids" Name="Lienzo.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.tga\OpenWithProgids" Name="Lienzo.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.exr\OpenWithProgids" Name="Lienzo.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.hdr\OpenWithProgids" Name="Lienzo.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.avif\OpenWithProgids" Name="Lienzo.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.qoi\OpenWithProgids" Name="Lienzo.Image" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\.ico\OpenWithProgids" Name="Lienzo.Image" Value="" Type="string" />

        <!-- "Open with" app list and the Run dialog (Win+R "lienzo"). -->
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\lienzo.exe" Name="FriendlyAppName" Value="Lienzo" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\lienzo.exe\shell\open\command" Value="&quot;[#LienzoExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\lienzo.exe\SupportedTypes" Name=".lienzo" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\lienzo.exe\SupportedTypes" Name=".pcraft" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\lienzo.exe\SupportedTypes" Name=".psd" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\lienzo.exe\SupportedTypes" Name=".psb" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\lienzo.exe\SupportedTypes" Name=".pdn" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\lienzo.exe\SupportedTypes" Name=".ora" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\lienzo.exe\SupportedTypes" Name=".kra" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\lienzo.exe\SupportedTypes" Name=".krz" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\lienzo.exe\SupportedTypes" Name=".png" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\lienzo.exe\SupportedTypes" Name=".jpg" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\lienzo.exe\SupportedTypes" Name=".jpeg" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\lienzo.exe\SupportedTypes" Name=".tif" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\lienzo.exe\SupportedTypes" Name=".tiff" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\lienzo.exe\SupportedTypes" Name=".webp" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\lienzo.exe\SupportedTypes" Name=".gif" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\lienzo.exe\SupportedTypes" Name=".bmp" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\lienzo.exe\SupportedTypes" Name=".tga" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\lienzo.exe\SupportedTypes" Name=".exr" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\lienzo.exe\SupportedTypes" Name=".hdr" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\lienzo.exe\SupportedTypes" Name=".avif" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\lienzo.exe\SupportedTypes" Name=".qoi" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Classes\Applications\lienzo.exe\SupportedTypes" Name=".ico" Value="" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\lienzo.exe" Value="[#LienzoExe]" Type="string" />
        <RegistryValue Root="HKMU" Key="Software\Lienzo" Name="InstallDir" Value="[INSTALLFOLDER]" Type="string" />
      </Component>

      <Component Id="LienzoCli">
        <File Id="LienzoCliExe" Source="$(var.BinDir)\lienzo-cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
